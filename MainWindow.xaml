<Window x:Class="Karu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Karu" Width="1200" Height="780"
        Icon="pack://application:,,,/karu.ico"
        Background="#111111"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="-1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#444444"/>
                                <Setter Property="Foreground" Value="#DDDDDD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MaxRestoreButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Content" Value="&#xE922;"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <DockPanel>
            <!-- 細いタイトルバー: ドラッグ領域 + メニュー + ウィンドウ操作のみ (タブ/URLバーは廃止、操作はキーとオーバーレイ) -->
            <DockPanel x:Name="TopBar" DockPanel.Dock="Top" Height="40" Background="#111111">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MenuBtn" Style="{StaticResource CaptionButton}" Content="&#xE700;"
                            ToolTip="メニューとお気に入り" Click="Menu_Click"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            ToolTip="最小化" Click="MinWin_Click"/>
                    <Button Style="{StaticResource MaxRestoreButton}"
                            ToolTip="最大化 / 元に戻す" Click="MaxWin_Click"/>
                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                            ToolTip="閉じる" Click="CloseWin_Click"/>
                </StackPanel>
                <TextBlock Text="Karu" Foreground="#666666" FontSize="12" VerticalAlignment="Center"
                           Margin="14,0,0,0"/>
                <Border Background="Transparent"/>
            </DockPanel>

            <Grid x:Name="WebHost" Background="#111111"/>
        </DockPanel>

        <!-- ブックマーク名編集オーバーレイ (Ctrl+D) -->
        <Border x:Name="StarOverlay" Visibility="Collapsed" Background="#AA000000"
                MouseDown="StarOverlay_MouseDown">
            <Border Background="#1A1A1A" CornerRadius="8" BorderBrush="#D4845E" BorderThickness="1"
                    Padding="12" Width="320" Height="Auto"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseDown="Overlay_Inner_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="お気に入りに追加" Foreground="#D4845E" FontSize="11"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="StarNameBox" Background="#0D0D0D" Foreground="#DDDDDD"
                             CaretBrush="#DDDDDD" SelectionBrush="#D4845E"
                             BorderBrush="#333333" BorderThickness="1"
                             Padding="8,6" FontSize="13" KeyDown="StarNameBox_KeyDown"/>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource MenuItemButton}"
                                Content="保存" Width="60" HorizontalContentAlignment="Center"
                                Click="StarSave_Click"/>
                        <Button Style="{StaticResource MenuItemButton}"
                                Content="キャンセル" Width="80" HorizontalContentAlignment="Center"
                                Click="StarCancel_Click"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- URL / 検索入力オーバーレイ (o / Ctrl+L) -->
        <Border x:Name="UrlOverlay" Visibility="Collapsed" Background="#AA000000"
                MouseDown="UrlOverlay_MouseDown">
            <Border Background="#1A1A1A" CornerRadius="8" BorderBrush="#D4845E" BorderThickness="1"
                    Padding="14" Width="560"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseDown="Overlay_Inner_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="URL / 検索" Foreground="#D4845E" FontSize="11" Margin="0,0,0,8"/>
                    <TextBox x:Name="UrlInputBox" Background="#0D0D0D" Foreground="#DDDDDD"
                             CaretBrush="#DDDDDD" SelectionBrush="#D4845E"
                             BorderBrush="#333333" BorderThickness="1"
                             Padding="8,7" FontSize="14" KeyDown="UrlInputBox_KeyDown"/>
                    <TextBlock Text="Enter: 開く · Shift+Enter: 新しいタブ · Esc: 閉じる"
                               Foreground="#666666" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- タブ一覧オーバーレイ (,) -->
        <Border x:Name="TabOverlay" Visibility="Collapsed" Background="#AA000000" Focusable="True"
                MouseDown="TabOverlay_MouseDown">
            <Border Background="#1A1A1A" CornerRadius="10" BorderBrush="#333333" BorderThickness="1"
                    Padding="14" Width="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseDown="Overlay_Inner_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="j/k+Enter: 選択して開く · Ctrl+W: 閉じる · キー: 切替 / Shift+キー: 閉じる"
                                   Foreground="#666666" FontSize="11"/>
                        <TextBlock Text="TABS" Foreground="#D4845E" FontSize="11"/>
                    </DockPanel>
                    <ScrollViewer MaxHeight="470" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TabListPanel"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Border>

        <!-- メニュー & お気に入り -->
        <Popup x:Name="MenuPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=MenuBtn}" HorizontalOffset="-300">
            <Border Background="#1A1A1A" CornerRadius="10" BorderBrush="#333333" BorderThickness="1"
                    Margin="10" Padding="8" Width="340">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="お気に入り" Foreground="#888888" FontSize="11" Margin="10,6,10,4"/>
                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Bookmarks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource TabCloseButton}"
                                                Content="&#xE711;" VerticalAlignment="Center" Margin="4,0,6,0"
                                                ToolTip="削除" Click="BookmarkDelete_Click" Tag="{Binding}"/>
                                        <Button Style="{StaticResource MenuItemButton}" Content="{Binding Title}"
                                                ToolTip="{Binding Url}" Click="BookmarkOpen_Click" Tag="{Binding}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="NoBookmarksText" Text="（ページを開いて Ctrl+D で追加されます）"
                               Foreground="#666666" FontSize="12" Margin="10,2,10,6"/>
                    <Border Height="1" Background="#2A2A2A" Margin="6,6"/>
                    <Button Style="{StaticResource MenuItemButton}"
                            Content="タブ一覧 (Ctrl+Tab) ／ URL入力 (o / Ctrl+L)" Click="TabListMenu_Click"/>
                    <Button Style="{StaticResource MenuItemButton}"
                            Content="この動画を mpv で再生 — 超軽量 (Ctrl+M)" Click="Mpv_Click"/>
                    <Button Style="{StaticResource MenuItemButton}"
                            Content="このページを Edge で開く — DRM動画用 (Ctrl+E)" Click="OpenEdge_Click"/>
                    <Button Style="{StaticResource MenuItemButton}"
                            Content="テキストカーソルモード切替 (F7・要再起動)" Click="Caret_Click"/>
                    <Button x:Name="FocusMenuBtn" Style="{StaticResource MenuItemButton}"
                            Content="動画集中モード: ON（クリックでOFF）" Click="Focus_Click"/>
                    <Button x:Name="QualityMenuBtn" Style="{StaticResource MenuItemButton}"
                            Content="画質上限: 1080p" Click="Quality_Click"/>
                    <Button Style="{StaticResource MenuItemButton}"
                            Content="メモリ使用量を表示" Click="MemInfo_Click"/>
                    <Button Style="{StaticResource MenuItemButton}"
                            Content="設定フォルダを開く（ブロックリスト編集）" Click="OpenConfig_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
