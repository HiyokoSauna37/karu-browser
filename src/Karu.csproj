<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Karu</AssemblyName>
    <RootNamespace>Karu</RootNamespace>
    <!-- ローカルビルド用の基準値。リリースは release.yml がタグ名 (v0.2.0 → 0.2.0) で上書きする -->
    <Version>0.2.4</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>karu.ico</ApplicationIcon>
    <!-- ホスト側(WPF)の常駐メモリ削減: 併走GCスレッドを止める -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Windows専用アプリなのでRID固定。ReadyToRunの前提でもある -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- 起動時のJIT量を減らす。実測: host WorkingSet 197→184MB・初回ウィンドウ表示も短縮 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- ICU(国際化データ)を読み込まない。文字列比較はすべて序数/InvariantCultureで、
         カルチャ依存の照合・並べ替えは使っていないため影響しない -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="karu.ico" />
    <Resource Include="karu-flame1.png" />
    <Resource Include="karu-flame2.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- GCに省メモリ動作を指示 (0-9, 大きいほど積極的にヒープを返す) -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

</Project>
